<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Upbeater Builder を launchd で常駐させる。__NODE__ と __HOME__ と __DIR__ は install.sh が置き換える -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.upbeater.builder</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__DIR__/dist/main.js</string>
    <string>__HOME__/.upbeater/builder.json</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DIR__</string>
  <!-- ログイン時に起動し、落ちたら自動で起動し直す -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- 停止の合図から強制終了までの猶予（実行中のビルドを中断して報告する時間） -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME__/.upbeater/builder.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.upbeater/builder.log</string>
</dict>
</plist>
